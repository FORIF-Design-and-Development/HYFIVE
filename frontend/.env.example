# Set to 'false' when deploying inside react-native-webview (disables iPhone mock frame)
VITE_USE_MOBILE_FRAME=true

# Backend API base URL (Spring Boot)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth 2.0 Client ID (Web application)
# GCP Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=
